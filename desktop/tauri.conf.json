{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-v2/main/tooling/cli/schema.json",
  "productName": "BossMod AI",
  "version": "0.1.0",
  "identifier": "com.bossmodai.app",
  "build": {
    "devUrl": "http://127.0.0.1:38471",
    "frontendDist": "http://127.0.0.1:38471"
  },
  "app": {
    "windows": [
      {
        "title": "BossMod AI",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  }
}
